# Copia este archivo como ".env" en la carpeta api/ y llena los valores reales.
# El archivo .env NO se sube a git.

# --- Base de datos (Neon Postgres) ---
DB_URL=jdbc:postgresql://TU-HOST.neon.tech/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=TU-PASSWORD

# --- Auth0 ---
# Domain del tenant, con https:// y slash final. Ejemplo: https://sodablush.us.auth0.com/
AUTH0_ISSUER_URI=https://TU-TENANT.us.auth0.com/
# Identifier de la API creada en Auth0 (Audience)
AUTH0_AUDIENCE=https://api.sodablush.com

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
